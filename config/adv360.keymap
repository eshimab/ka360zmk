        };

        mc_spc_shift: mc_spc_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &sk RIGHT_SHIFT>;
            label = "MC_SPC_SHIFT";
        };
    };

