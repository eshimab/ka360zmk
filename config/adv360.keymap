            #binding-cells = <0>;
            bindings = <&skq RALT>;
        };

        mc_rcmdx2: mc_rcmdx2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RGUI &kp RGUI>;
