        mcToOfcKp: mcToOfcKp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&to 2 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };

        mcToOfcSkLSKp: mcToOfcSkLSKp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&to 2>,
                <&macro_tap>,
                <&sk LEFT_SHIFT &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

