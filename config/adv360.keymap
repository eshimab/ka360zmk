    macros {
        mcskq_lctrl: mcskq_lctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&skq LCTRL>;
        };

        mcskq_rctrl: mcskq_rctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&skq RCTRL>;
        };

        mcskq_lgui: mcskq_lgui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&skq LGUI>;
        };

        mcskq_rgui: mcskq_rgui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&skq RGUI>;
        };

        mcskq_lshift: mcskq_lshift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&skq LSHIFT>;
        };

        mcskq_rshift: mcskq_rshift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&skq RSHIFT>;
        };

        mcskq_lalt: mcskq_lalt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&skq LALT>;
        };

        mcskq_ralt: mcskq_ralt {
