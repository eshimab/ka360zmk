        };

        cb_72-73_ralt {
            bindings = <&sk RALT>;
            key-positions = <72 73>;
            timeout-ms = <75>;
        };

        cb_r5l_spc {
            bindings = <&kp SPACE>;
            key-positions = <62 63 64>;
        };

        cb_r5r_spc {
            bindings = <&kp SPACE>;
            key-positions = <71 72 73>;
        };
    };

    macros {
        mc_sk_ctrl: mc_sk_ctrl {
            //label = "MC_SK_CTRL";

            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LCTRL>;
        };

        mc_sk_gui: mc_sk_gui {
            //label = "MC_SK_GUI";

            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LGUI>;
        };

        mc_sk_shift: mc_sk_shift {
            //label = "MC_SK_SHIFT";

            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LSHIFT>;
        };

        mc_sk_alt: mc_sk_alt {
            //label = "MC_SK_ALT";

            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LALT>;
        };

        mc_rcmdx2: mc_rcmdx2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RGUI &kp RGUI>;
            label = "MC_RCMDX2";
        };

        mc_spc_shift: mc_spc_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &sk RIGHT_SHIFT>;
            label = "MC_SPC_SHIFT";
        };
    };

