            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>; // prevent hold during fast typing (default = <0>)
            // ====== interupt flavor

            flavor = "tap-preferred";

            // ====== behavior bindings

            bindings = <&kp>, <&kp>;

